{
  "name": "react-store-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "seed:catalog": "npm run build && node dist/scripts/seed-catalog.js",
    "catalog:assign-branches": "npm run build && node dist/scripts/assign-catalog-branches.js",
    "seed:photos": "node seed/import-photos.mjs",
    "owner:create": "npm run build && node dist/scripts/create-owner.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "dotenv": "18.0.9",
    "mongodb": "7.8.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
